== add agent before start
--- orders.yaml
+++ orders.yaml
@@ -3,5 +3,5 @@
 version: 0
 flow: release   # the name shown on the page
-start: build
+start: plan
 
 # Adapters that run agent steps.
@@ -15,4 +15,15 @@
 
 nodes:
+  plan:
+    type: agent
+    executor: stub
+    prompt: prompts/plan.md
+    schema: schemas/plan.json
+    model: m1
+    effort: low
+    tools: [read]
+    max_attempts: 2
+    on: {ok: build, unclear: failed, fail: failed}
+
   # Compile everything.
   build:
--- /dev/null
+++ prompts/plan.md
@@ -0,0 +1,5 @@
+Step plan. Replace this text with what the step must do.
+
+{{rework}}
+
+Reply with a single JSON object: "outcome" is one of ok, unclear, and "summary" says in a sentence what you did.
--- /dev/null
+++ schemas/plan.json
@@ -0,0 +1,9 @@
+{
+  "type": "object",
+  "properties": {
+    "outcome": {"type": "string", "enum": ["ok", "unclear"]},
+    "summary": {"type": "string"}
+  },
+  "required": ["outcome"],
+  "additionalProperties": false
+}
